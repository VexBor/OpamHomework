## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (Mono Auto Generated)
mono_crash.*

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2019+
.vs/

# Rider
.idea/
*.sln.iml

# NuGet
*.nupkg
*.snupkg
# NuGet Symbol Packages
*.symbols.nupkg
# The packages folder can be ignored
**/[Pp]ackages/*
!**/[Pp]ackages/build/
!**/[Pp]ackages/repositories.config

# Others
*.dbmdl
*.bak
*.backup
*.swp
*.tmp
*.temp
*.log

# OS-specific files
.DS_Store
Thumbs.db

# dotnet tools
.tools/
